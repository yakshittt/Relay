# Change this to a long random secret before exposing the API.
RELAY_API_TOKEN=replace-me-with-a-long-random-secret
DEVICE_TOKEN=replace-me-with-another-long-random-secret

# Demo switches. Never expose demo controls on a public production deployment.
DEMO_MODE=true
DATA_PATH=./relay.sqlite3

# Set these to match your environment. These are examples, not assumptions about the Jio router.
RELAY_PROBE_HOST=example.com
BUSINESS_HOST=example.com
BUSINESS_URL=https://example.com/
ESP32_STALE_SECONDS=45
