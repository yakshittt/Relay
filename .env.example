# -----------------------------------------------------------------------------
# RELAY Environment Configuration Template
# -----------------------------------------------------------------------------
# IMPORTANT:
# - Never commit real API keys, tokens, or production passwords to source control.
# - In local development: copy this file to an untracked `.env` file (`cp .env.example .env`).
# - In a deployed environment: inject secrets directly via container environment variables,
#   systemd environment files, or platform secret managers (e.g. AWS Secrets Manager,
#   Kubernetes Secrets, Vault) rather than static files.
# -----------------------------------------------------------------------------

# API Authentication Tokens
# Change these to long, cryptographically random strings before exposing the API.
RELAY_API_TOKEN=replace-me-with-a-long-random-secret
DEVICE_TOKEN=replace-me-with-another-long-random-secret

# Operational Switches
# DEMO_MODE enables simulated fault injection and demo endpoints (/v1/demo/*).
# Set DEMO_MODE=false in any real production deployment.
DEMO_MODE=true
DATA_PATH=./relay.sqlite3

# Diagnostic Probe Targets
# Set these to match your network environment. These examples are safe defaults.
RELAY_PROBE_HOST=example.com
BUSINESS_HOST=example.com
BUSINESS_URL=https://example.com/
ESP32_STALE_SECONDS=45

# -----------------------------------------------------------------------------
# AI Incident Interpretation Configuration
# -----------------------------------------------------------------------------
# AI_PROVIDER:
#   - "mock" (default): Fully offline, deterministic test provider. Requires NO API key
#     or network connectivity. Returns static rule-synthesized narrative for tests.
#     NOTE: The mock provider does NOT demonstrate genuine LLM-generated reasoning.
#   - "openai": Connects to OpenAI or any OpenAI-compatible API endpoint (e.g. vLLM,
#     Ollama, Groq, Azure OpenAI).
AI_PROVIDER=mock

# AI Model Identifier
# Default for OpenAI-compatible endpoint (e.g., gpt-4o-mini, gpt-4o, llama-3.1-8b)
AI_MODEL=gpt-4o-mini

# AI Provider API Key
# Required when AI_PROVIDER="openai". Leave blank when AI_PROVIDER="mock".
# NEVER commit real credentials to this file or any tracked repository file.
AI_API_KEY=

# AI Provider Base URL
# Default points to OpenAI public API. Can be redirected to local or private proxies.
AI_API_BASE_URL=https://api.openai.com/v1

# AI HTTP Request Timeout (in seconds)
AI_REQUEST_TIMEOUT_SECONDS=10.0


